{
  "expo": {
    "name": "Seviye",
    "slug": "seviye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#007AFF" },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.seviye",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false, "CFBundleDisplayName": "Seviye" }
    },
    "android": {
      "package": "com.example.seviye",
      "adaptiveIcon": {
        "backgroundColor": "#007AFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png" }
  }
}
